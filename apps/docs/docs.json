              "commerce/hire-an-agent",
              "commerce/sell-services",
              "commerce/e2e-dogfood",
              "pay-any-api",
              "sell-to-agents/overview"
            ]
          },
          {
            "group": "Wallet",
            "pages": [
              "agent-id",
              "agent-wallet"
            ]
          },
          {
            "group": "Trading",
            "pages": [
              "trading/swaps"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "cli-reference",
              "agent-sdk"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]

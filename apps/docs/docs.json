            "group": "Reference",
            "pages": [
              "cli-reference",
              "agent-sdk",
              "agent-stack"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },

{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "t2000",
  "description": "The agent economy on Sui — A2A commerce, x402 payments, on-chain identity, and a USDC wallet. Passport Connect, CLI, SDK, and MCP.",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo.png",
    "dark": "/logo.png"
  },
  "colors": {
    "primary": "#0a0a0a",
    "light": "#ededed",
    "dark": "#ffffff"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "navigation": {
